# Rumina 鬼教官 — Phase 1 環境変数
# このファイルを .env にコピーして値を入れる（.env はコミットしない）

# 必須：OpenAI APIキー（Whisper文字起こし用）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 認証・セッション（本番は必ず設定）
SESSION_SECRET=change-me-please
OWNER_USER=川上
OWNER_PASSWORD=set-your-own

# LINEログイン（LINE Developers の「LINEログイン」チャネル）※設定すると「LINEでログイン」ボタンが出る
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# LINE_CALLBACK_URL は未設定ならアクセス中のホストから自動生成（例 https://xxx.up.railway.app/api/line/callback）
LINE_CALLBACK_URL=
# 川上のLINEユーザーIDを入れると、その人だけ管理者(owner)としてログインできる（任意）
OWNER_LINE_ID=

# データ永続化（重要）：ユーザー・登録モデル・診断ログの保存先。
# 本番(Railway)は Volume をマウントして必ず /data を指すこと。未設定だと
# アプリ直下 ./data に保存され、再デプロイで消える。
DATA_DIR=/data
# 診断ログの保持件数（索引の上限。超えたら古いものから索引を落とす）
REPORT_LOG_CAP=1000

# 録音・解析への同意。文言を改訂したらこの版を上げると全員に再同意を求める。
CONSENT_VERSION=2026-07-15
# 文字起こし後に音声ファイルを自動削除する（個人情報を残さない運用）。on/true で有効・既定は保持。
PURGE_AUDIO_AFTER_ANALYZE=

# cyzen連携（行動量＝訪問数・アポの確定値）。CSV書き出しを置いたフォルダを指す。
#   <dir>/user-master.csv      … ユーザーマスター(utf-8)
#   <dir>/action-history.csv   … 行動履歴(Shift_JIS・任意/大容量)
#   <dir>/report/*.csv         … 報告書各種(Shift_JIS)
# 未設定ならcyzen照合はオフ（従来どおりGPS/文面推定）。将来はAPI連携に差し替え。
CYZEN_DATA_DIR=
# 行動履歴(大容量)の読み込みを飛ばす場合は on
CYZEN_SKIP_HISTORY=

# LINE bot 個別コーチング連携（/api/coach-context）の共有シークレット。
# botサーバーがこのキー付きで叩くと、LINE userId→本人の最新診断＋一言処方を返す。空なら無効。
BOT_API_SECRET=

# 任意
PORT=4180
WHISPER_MODEL=whisper-1
VISIT_GAP_SEC=60      # この秒数以上の無音を「別の家」の境界とみなす
IDLE_GAP_SEC=1200     # この秒数(20分)以上の空白を「サボり疑い」候補に

# Rumina Coach 連携（任意。測定完了時にCoachのwebhookへ解析結果を送る）
# Coachの測定依頼リンク（?staff=&iv=）経由でアクセスした場合のみ送信される。
# 未設定なら何も送らない（既存の使い方に影響なし）。
COACH_WEBHOOK_URL=
COACH_WEBHOOK_SECRET=

# 入力リマインド（GPSで動いてるのに未入力の人へLINEでやさしく催促）
REMINDER_ENABLED=            # on で実送信を有効化（既定は空=ドライラン）
LINE_MESSAGING_TOKEN=        # LINE Messaging APIのチャネルアクセストークン（push用）
REMINDER_INTERVAL_HOURS=2    # 何時間ごとに送るか
REMINDER_DAILY_CAP=4         # 1人1日あたりの上限回数
REMINDER_QUIET_START=9       # JST これ以降に送る
REMINDER_QUIET_END=21        # JST これ未満まで送る

# cyzenライブ更新（5分ごとに報告書ベースの行動量を最新化）
CYZEN_LIVE_REFRESH=          # off で停止（既定=有効・cyzen API設定時のみ動く）
CYZEN_REFRESH_MINUTES=5      # 更新間隔（分）
# ※GPS履歴は件数が多く5分取得は非現実的なため、ライブ更新は報告書ベース。
#   空データ/マッピング失敗時は適用せず同梱スナップショットを維持する安全弁つき。

# ===== Google Cloud 連携（段階導入・すべて既定OFF。キー未設定でもMockで動作） =====
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=asia-northeast1
# サービスアカウント鍵（Vertex AI/BigQuery/Drive/Speech/DocAI用）。JSONそのまま、または base64
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SA_BASE64=
# Maps はブラウザ用とサーバー用の鍵を分ける
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
# Workspace OAuth（Calendar/Drive）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# BigQuery / Pub/Sub
GOOGLE_BIGQUERY_DATASET=rumina_analytics
GOOGLE_PUBSUB_ACTIVITY_TOPIC=
GOOGLE_PUBSUB_DEAD_LETTER_TOPIC=
# Firebase（FCM Push）
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Feature Flags（機能ごとに段階的にON）
FEATURE_GOOGLE_MAPS=false
FEATURE_GOOGLE_CALENDAR=false
FEATURE_GOOGLE_DRIVE=false
FEATURE_GOOGLE_SOLAR=false
FEATURE_GOOGLE_WEATHER=false
FEATURE_VERTEX_AI=false
FEATURE_SPEECH_TO_TEXT=false
FEATURE_DOCUMENT_AI=false
FEATURE_FIREBASE_PUSH=false
